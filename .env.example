# Payment Method Service - Environment Variables

# Server Configuration
PORT=8080
GIN_MODE=debug
LOG_LEVEL=debug

# Database Configuration — payment_method_db
# Rol de aplicación SIN DDL ni superuser (PLAT-E26 T3, RULE-09/RULE-10): el runtime NUNCA
# se conecta como postgres — un superuser bypasea RLS (rolbypassrls=t) y anula el aislamiento
# por tenant de la policy `tenant_isolation` de 005_rls_payment_methods.up.sql. `payment_method_app`
# tiene SELECT sobre los tres planos + INSERT/UPDATE/DELETE solo sobre `payment_methods` (plano
# tenant); global/marketplace son control-plane (SELECT-only). Rol creado por MC-E37
# migrations/004_create_app_role (LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS); el
# password se fija out-of-band contra lab-postgres, nunca versionado. En producción: password
# fuerte vía secret, nunca en este archivo. Las migraciones (DDL) siguen corriendo con un rol
# administrador (postgres), fuera del runtime.
#
# ⚠️ Orden de flip del runtime real (compose raíz `mc-payment-method-service`): el contenedor NO
# debe pasar a `payment_method_app` hasta que T4 envuelva el repository en `WithRLSInTransaction`
# (fija `app.tenant_id`). Con RLS activo (T2) + repo sin fijar el GUC, toda lectura como rol
# NOBYPASSRLS falla con `unrecognized configuration parameter "app.tenant_id"` (verificado 2026-07-11).
# El flip del compose raíz se hace en T5, igual que ledger-service (E24). Este .env.example
# documenta el destino del runtime.
DB_HOST=localhost
DB_PORT=5432
DB_USER=payment_method_app
DB_PASSWORD=payment_method_app123
DB_NAME=payment_method_db
DB_SSLMODE=disable

# Monitoring
PROMETHEUS_ENABLED=true
